# Copia este archivo como render-db.local.env y rellena con los datos de Render
# (Dashboard → tu PostgreSQL → pestaña "Connections" → External Database URL).
#
# La URL JDBC debe llevar doble barra tras postgresql:
#   jdbc:postgresql://dpg-xxxxx-a.REGION.render.com:5432/NOMBRE_BD?sslmode=require
#
# Si Render solo muestra postgresql://usuario:pass@host:5432/db → convierte a las tres variables
# o usa una sola línea URL con usuario/pass embebidos (menos cómodo).

SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-REEMPLAZA.REGION.render.com:5432/sportster?sslmode=require
SPRING_DATASOURCE_USERNAME=sportster
SPRING_DATASOURCE_PASSWORD=REEMPLAZA_CON_LA_PASSWORD_DEL_PANEL
